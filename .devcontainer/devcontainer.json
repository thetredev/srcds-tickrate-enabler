{
  "name": "srcds-tickrate-enabler",
  "image": "ghcr.io/thetredev/srcds-tickrate-enabler:bear",

  "containerEnv": {
    "EDITOR": "${localEnv:EDITOR:code --wait}",
    "GIT_EDITOR": "${localEnv:EDITOR:code --wait}"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.makefile-tools",
        "ms-vscode.cpptools-extension-pack",
        "tamasfe.even-better-toml",
        "rust-lang.rust-analyzer"
      ]
    }
  },

  "mounts": [
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,ro,type=bind,consistency=cached"
  ],

  "remoteUser": "vscode"
}
